# ─── Discord / bot connection ────────────────────────────────────────────────
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
# Supabase project (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key for lifecycle/database operations. Never expose this to the browser.
SUPABASE_SECRET_KEY=

# Bot control endpoint (Speak/Music pages). Must match the bot's .env.
BOT_CONTROL_URL=http://127.0.0.1:8787
BOT_CONTROL_SECRET=

# Bot lifecycle controls (used by the admin dashboard on the same host).
# BOT_WORKDIR=..
# BOT_START_COMMAND=npm run start

# VOICEVOX engine URL (Speak page voice list). Defaults to http://127.0.0.1:50021.
# VOICEVOX_URL=http://127.0.0.1:50021

# ─── Dashboard authentication (Supabase Auth + Discord OAuth) ────────────────
# Enable Discord under Supabase Dashboard → Authentication → Providers, then
# add the Supabase callback URL shown there to the Discord application's OAuth2 redirects.
# Add this app callback URL to Supabase Dashboard → Authentication → URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Dashboard users are created as members after Discord login. Promote admins by
# updating public."DashboardUser".role in Supabase (admin or member).
# DEV ONLY — set to "admin" or "member" to skip Discord login during local
# development. Ignored when NODE_ENV=production. Leave blank to require login.
DEV_AUTH_BYPASS=
# Optional: lock remote (ngrok) users to one server. Blank = any bot server.
REMOTE_GUILD_ID=
# Optional: extra hosts treated as local (full role).
# LOCAL_HOSTS=localhost,127.0.0.1,::1
