# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env or share your token publicly.

# Bot token — Discord Developer Portal > your app > "Bot" tab > Reset/Copy Token
DISCORD_TOKEN=your-bot-token-here

# Application (Client) ID — Developer Portal > your app > "General Information"
CLIENT_ID=your-application-id-here

# OPTIONAL: a test server ID for instant command updates during development.
# Right-click your server icon in Discord (with Developer Mode on) > "Copy Server ID".
# Leave blank to register commands globally (can take up to ~1 hour to appear).
GUILD_ID=

# PostgreSQL (Docker) connection string
DATABASE_URL=postgresql://megu:megu_dev_password@localhost:5432/megu

# ─── Text-to-speech (/say and /sayjp) ────────────────────────────────────────
# The bot speaks in voice channels via a pluggable TTS provider. Leave blank for
# the OpenAI default. /sayjp always uses VOICEVOX regardless of this setting.
#
#   AI_TTS_PROVIDER : openai | gemini | voicevox | googletts   (default: openai)
# voicevox  = free local anime-girl TTS engine (Japanese only, no API key).
# googletts = free Google Translate TTS (Thai + many languages, no API key).
#             Set the default language with GTTS_LANG (default: th).
AI_TTS_PROVIDER=openai

# API key for the selected TTS provider (only openai/gemini need one;
# voicevox and googletts are keyless).
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OPTIONAL: override the API key / model for the TTS stage specifically.
# Defaults: openai → tts-1, gemini → gemini-2.5-flash-preview-tts.
# AI_TTS_API_KEY=
# AI_TTS_MODEL=

# TTS voice. Defaults: "alloy" for openai, "Kore" for gemini, "3" for voicevox.
# OpenAI voices: alloy, echo, fable, onyx, nova, shimmer.
# Gemini voices: Kore, Puck, Charon, Fenrir, Aoede, etc. (see Gemini docs).
# VOICEVOX: a speaker id number (e.g. 3 = ずんだもん/Zundamon). The /say command's
# "voice" dropdown lets you pick per-message, so this is just the default.
AI_TTS_VOICE=alloy

# VOICEVOX engine URL. Used by the /sayjp command (Japanese anime voices), which
# always uses VOICEVOX regardless of AI_TTS_PROVIDER, and by /say when
# AI_TTS_PROVIDER=voicevox. Download/run the engine from
# https://voicevox.hiroshiba.jp/ — it listens here by default:
# VOICEVOX_URL=http://localhost:50021

# Default language for Google TTS (AI_TTS_PROVIDER=googletts or the dashboard's
# Google engine). e.g. th=Thai, en=English, ja=Japanese.
# GTTS_LANG=th

# ─── Web dashboard control endpoint ──────────────────────────────────────────
# The bot opens a small HTTP server on 127.0.0.1 so the dashboard's "Speak" page
# can make the bot talk in a voice channel. Set BOT_CONTROL_SECRET to any random
# string and put the SAME value in dashboard/.env.local. Set BOT_CONTROL_PORT=0
# to disable the endpoint entirely.
BOT_CONTROL_PORT=8787
BOT_CONTROL_SECRET=

# ─── YouTube music player (/play) ────────────────────────────────────────────
# Audio is pulled with yt-dlp via the bundled "youtube-dl-exec" package, so no
# setup is normally needed. Override only if you want a system-installed yt-dlp:
# YTDLP_PATH=C:\tools\yt-dlp.exe
#
# YouTube blocks anonymous requests with "Sign in to confirm you're not a bot".
# By default the bot works around this with no setup by using yt-dlp's 'android'
# player client (no login needed). That client only offers a ~360p combined
# stream though — fine for audio, but heavier. For full audio-only quality, give
# yt-dlp your cookies (which also switches off the android default):
#   - Easiest: read cookies from your browser (installed + logged into YouTube).
#     Value: chrome | edge | firefox | brave  (or e.g. "chrome:Profile 1").
#     Close the browser if it complains the cookie DB is locked.
# YTDLP_COOKIES_FROM_BROWSER=chrome
#   - Or an exported cookies.txt (takes priority if both are set):
# YTDLP_COOKIES=C:\path\to\cookies.txt
#   - Advanced: force a specific extractor client (overrides the android default):
# YTDLP_PLAYER_CLIENT=android
#
# OPTIONAL tuning (defaults shown):
#   MUSIC_DEFAULT_VOLUME : starting volume 0–100                       (default 100)
#   MUSIC_IDLE_TIMEOUT_MS: leave the channel after this idle period    (default 120000)
#   MUSIC_MAX_QUEUE      : cap on queued tracks per guild              (default 100)
# MUSIC_DEFAULT_VOLUME=100
# MUSIC_IDLE_TIMEOUT_MS=120000
# MUSIC_MAX_QUEUE=100
