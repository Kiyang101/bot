# ─── Discord / bot connection ────────────────────────────────────────────────
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
DATABASE_URL=postgresql://megu:megu_dev_password@localhost:5432/megu

# Bot control endpoint (Speak/Music pages). Must match the bot's .env.
BOT_CONTROL_URL=http://127.0.0.1:8787
BOT_CONTROL_SECRET=

# Bot lifecycle controls (used by the admin dashboard on the same host).
# BOT_WORKDIR=..
# BOT_START_COMMAND=npm run start

# VOICEVOX engine URL (Speak page voice list). Defaults to http://127.0.0.1:50021.
# VOICEVOX_URL=http://127.0.0.1:50021

# ─── Dashboard authentication (Discord OAuth2) ───────────────────────────────
# Discord Dev Portal → your app → OAuth2 → Client Secret.
DISCORD_CLIENT_SECRET=
# Must be registered under OAuth2 → Redirects in the Dev Portal.
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Secret for signing session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Allowlists of Discord user IDs (comma-separated). Anyone not listed is denied.
#   ADMIN  = full access to every page.
#   MEMBER = Speak + Music pages only.
ADMIN_USER_IDS=
MEMBER_USER_IDS=
# DEV ONLY — set to "admin" or "member" to skip Discord login during local
# development. Ignored when NODE_ENV=production. Leave blank to require login.
DEV_AUTH_BYPASS=
# Public guest access for REMOTE (ngrok) visitors — they skip login and get this
# role automatically. Local (localhost) requests are unaffected. Usually
# "member" (Speak + Music only). Blank = remote visitors must log in.
PUBLIC_GUEST_ACCESS=
# Lock REMOTE (ngrok) visitors to a single Discord server (they can't switch
# away from it). Blank = remote visitors can select any server the bot is in.
GUEST_GUILD_ID=
# Set to "true" to let the bot's /dashboard link open WITHOUT a Discord login:
# the visitor gets member access (Speak + Music only), locked to the server in
# the link with no way to switch servers. Blank = the link just pre-selects the
# server and normal login is still required.
DASHBOARD_PUBLIC_LINK=
# Optional: extra hosts treated as local (full role, no guest access).
# LOCAL_HOSTS=localhost,127.0.0.1,::1
