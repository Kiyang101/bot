{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "A Discord bot built with discord.js v14 + TypeScript",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "prod": "tsc && node dist/index.js",
    "serve": "node dist/index.js",
    "deploy": "tsx src/deploy-commands.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "workspaces": [
    "dashboard"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@google/generative-ai": "^0.24.1",
    "@noble/ciphers": "^2.2.0",
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.4",
    "openai": "^6.44.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "sodium-native": "^5.1.0",
    "ws": "^8.21.0",
    "youtube-dl-exec": "^3.1.8"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "prisma": "^6.19.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
