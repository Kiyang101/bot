// Prisma schema — the single source of truth for the database.
// Shared by the bot (writes voice events + config) and the dashboard (reads them).
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Per-server settings, configurable from the dashboard or the /voicelog command.
model GuildConfig {
  guildId      String   @id // Discord server (guild) ID
  logChannelId String? // text channel where voice activity is posted (null = disabled)
  updatedAt    DateTime @updatedAt @default(now())
}

/// Singleton lifecycle record for the bot process, shared by the bot and dashboard.
model BotRuntime {
  id        Int       @id @default(1)
  status    BotStatus @default(STOPPED)
  pid       Int?
  startedAt DateTime?
  stoppedAt DateTime?
  lastError String?
  updatedAt DateTime  @updatedAt @default(now())
}

enum BotStatus {
  STARTING
  RUNNING
  STOPPING
  STOPPED
  ERROR
}

/// One row per voice action, so the dashboard can show a history.
model VoiceEvent {
  id              Int         @id @default(autoincrement())
  guildId         String
  userId          String
  username        String // denormalized display name, so the dashboard needs no extra lookups
  action          VoiceAction
  channelId       String? // the channel joined/left, or the destination of a move
  channelName     String?
  fromChannelId   String? // only set for MOVE
  fromChannelName String?
  createdAt       DateTime    @default(now())

  @@index([guildId, createdAt]) // fast "recent events for this server" queries
}

/// A track requested from the dashboard, kept so it can be played again later.
model MusicHistory {
  id          Int      @id @default(autoincrement())
  guildId     String
  title       String
  url         String
  durationSec Int?
  thumbnail   String?
  uploader    String?
  createdAt   DateTime @default(now())

  @@index([guildId, createdAt]) // fast recent history queries for a server
}

enum VoiceAction {
  JOIN
  LEAVE
  MOVE
}
